{
  "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "__NAWALA_HOOK__ prompt --agent claude", "timeout": 10 }] }],
  "Stop": [{ "hooks": [{ "type": "command", "command": "__NAWALA_HOOK__ stop --agent claude", "timeout": 10 }] }],
  "SessionStart": [{ "hooks": [{ "type": "command", "command": "__NAWALA_HOOK__ start --agent claude", "timeout": 10 }] }],
  "SessionEnd": [{ "hooks": [{ "type": "command", "command": "__NAWALA_HOOK__ end --agent claude", "timeout": 10 }] }],
  "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "__NAWALA_HOOK__ touch --agent claude", "timeout": 5 }] }]
}
